# Alexandria 运行配置（全部可选）

# 监听地址与端口
ALEXANDRIA_HOST=127.0.0.1
ALEXANDRIA_PORT=4520

# 数据目录（默认 ./data）
# ALEXANDRIA_DATA_DIR=./data
# ALEXANDRIA_DB_PATH=./data/alexandria.db
# ALEXANDRIA_UPLOADS_DIR=./data/uploads
# ALEXANDRIA_THUMBS_DIR=./data/thumbnails

# 会话有效期（小时）
ALEXANDRIA_SESSION_TTL_HOURS=336

# 单文件上传上限（MB）
ALEXANDRIA_MAX_UPLOAD_MB=80

# 本机 DSH（默认启用；无凭据/不可用时自动回退规则编译与本地检索）
ALEXANDRIA_DSH_ENABLED=true
# API 每 IP 每分钟请求上限（读写分开计数）
# ALEXANDRIA_RATE_LIMIT_PER_MINUTE=1200
# 维护与自动备份（0 表示关闭自动备份）
# ALEXANDRIA_TRASH_RETENTION_DAYS=30
# ALEXANDRIA_AUDIT_RETENTION_DAYS=180
# ALEXANDRIA_REVIEW_SLA_DAYS=7
# ALEXANDRIA_AUTO_BACKUP_HOURS=0
# ALEXANDRIA_MAINTENANCE_INTERVAL_MINUTES=60
# 资料处理 worker 并发（默认 1；DSH 编译较重，建议 1–2）
ALEXANDRIA_INGEST_CONCURRENCY=1
# ALEXANDRIA_DSH_BIN=dsh
# ALEXANDRIA_DSH_PROFILE=headless
# ALEXANDRIA_DSH_TIMEOUT_MS=90000
# ALEXANDRIA_DSH_SEARCH_TIMEOUT_MS=2500  # 语义重排上限；超时回退本地 FTS/图谱
# ALEXANDRIA_DSH_SOURCE_HOME=~/.dsh
# DSH 会读取 ~/.dsh/.credentials.yaml 或 DEEPSEEK_API_KEY

# 企业 SSO（OIDC；未配置则不显示登录入口）
# ALEXANDRIA_OIDC_ISSUER=https://sso.example.com
# ALEXANDRIA_OIDC_CLIENT_ID=alexandria
# ALEXANDRIA_OIDC_CLIENT_SECRET=...
# ALEXANDRIA_OIDC_REDIRECT_URI=https://kb.example.com/api/auth/oidc/callback
# ALEXANDRIA_OIDC_SCOPES=openid email profile
# ALEXANDRIA_OIDC_LABEL=企业 SSO

# S3 兼容备份（可选；不配置则仅本地备份）
# ALEXANDRIA_S3_ENDPOINT=https://s3.example.com
# ALEXANDRIA_S3_BUCKET=alexandria-backups
# ALEXANDRIA_S3_REGION=us-east-1
# ALEXANDRIA_S3_ACCESS_KEY=...
# ALEXANDRIA_S3_SECRET_KEY=...
# ALEXANDRIA_S3_PREFIX=alexandria

# SCIM 2.0 供给（不配置则 /scim 返回 404）
# ALEXANDRIA_SCIM_TOKEN=scim-...

# 企业微信 / 本地 Mock（默认指向 wecom-mock:4800）
ALEXANDRIA_WECOM_ENABLED=true
ALEXANDRIA_WECOM_MODE=mock
ALEXANDRIA_WECOM_BASE_URL=http://127.0.0.1:4800
ALEXANDRIA_WECOM_AUTHORIZE_BASE=http://127.0.0.1:4800
ALEXANDRIA_WECOM_CORP_ID=wwmockcorp
ALEXANDRIA_WECOM_AGENT_ID=1000002
ALEXANDRIA_WECOM_SECRET=mock-secret
ALEXANDRIA_WECOM_CALLBACK_TOKEN=mock-token
ALEXANDRIA_WECOM_ENCODING_AES_KEY=abcdefghijklmnopqrstuvwxyz0123456789ABCDEFG
# 浏览器可访问的 Alexandria 地址，用于拼接 OAuth 回调
ALEXANDRIA_PUBLIC_URL=http://127.0.0.1:4520

# 生产示例：
# ALEXANDRIA_WECOM_MODE=wecom
# ALEXANDRIA_WECOM_BASE_URL=https://qyapi.weixin.qq.com
# ALEXANDRIA_WECOM_AUTHORIZE_BASE=https://open.weixin.qq.com
# ALEXANDRIA_WECOM_CORP_ID=ww...
# ALEXANDRIA_WECOM_SECRET=...
# ALEXANDRIA_PUBLIC_URL=https://kb.example.com

# 可选的 LLM 答案合成（不配置也能完整运行）
# ALEXANDRIA_LLM_BASE_URL=https://api.deepseek.com/v1
# ALEXANDRIA_LLM_API_KEY=sk-...
# ALEXANDRIA_LLM_MODEL=deepseek-chat
# ALEXANDRIA_LLM_TIMEOUT_MS=60000
