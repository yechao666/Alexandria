# Alexandria 运行配置（全部可选）

# 监听地址与端口
ALEXANDRIA_HOST=127.0.0.1
ALEXANDRIA_PORT=4520

# 数据目录（默认 ./data）
# ALEXANDRIA_DATA_DIR=./data
# ALEXANDRIA_DB_PATH=./data/alexandria.db
# ALEXANDRIA_UPLOADS_DIR=./data/uploads
# ALEXANDRIA_THUMBS_DIR=./data/thumbnails

# 会话有效期（小时）
ALEXANDRIA_SESSION_TTL_HOURS=336

# 单文件上传上限（MB）
ALEXANDRIA_MAX_UPLOAD_MB=80

# 可选的 LLM 答案合成（不配置也能完整运行）
# ALEXANDRIA_LLM_BASE_URL=https://api.deepseek.com/v1
# ALEXANDRIA_LLM_API_KEY=sk-...
# ALEXANDRIA_LLM_MODEL=deepseek-chat
# ALEXANDRIA_LLM_TIMEOUT_MS=60000
