[Unit]
Description=Alexandria enterprise knowledge base
After=network.target

[Service]
Type=simple
User=alexandria
Group=alexandria
WorkingDirectory=/opt/alexandria
EnvironmentFile=/etc/alexandria.env
ExecStart=/usr/bin/node /opt/alexandria/server/src/main.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alexandria
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
